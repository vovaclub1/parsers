# Пример .env — скопируй в .env и заполни своими значениями.
# Никогда не коммить .env в git.

# ── Bybit ────────────────────────────────────────────────────────
BYBIT_API_KEY=
BYBIT_SECRET_KEY=

# ── Gate.io ──────────────────────────────────────────────────────
GATEIO_API_KEY=
GATEIO_SECRET_KEY=

# ── BingX ────────────────────────────────────────────────────────
BINGX_API_KEY=
BINGX_SECRET_KEY=

# ── Telegram (Telethon — для слушателя каналов) ──────────────────
# Получить на my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# ── Telegram (логгер — бот, отдельно) ─────────────────────────────
# Создать у @BotFather, добавить в чат
TG_LOG_BOT_TOKEN=
TG_LOG_CHAT_ID=

# ── Прокси для парсера делистингов ───────────────────────────────
# Поддерживаются оба формата (через запятую, можно смешивать):
#   - host:port:user:pass               (формат Webshare/большинства провайдеров)
#   - user:pass@host:port               (стандарт)
#   - host:port                         (без авторизации)
# Можно оставить пустым — будет использоваться прямое подключение.
# Пример: 45.141.186.246:64216:user:pass,156.246.133.222:62246:user:pass
DELIST_PROXIES=

# ── CoinListing API key (wss://*.coinlisting.pro) ────────────────
COINLISTING_API_KEY=

# ── Дополнительные TG-каналы (FIX-batch-3, first-wins дедуп) ─────
# Listener будет слушать ОСНОВНОЙ канал + эти. Дубликаты отсекаются
# через _fired_coins (TTL 60с) — кто из каналов опередил, тот и
# побеждает. Через запятую: username (без @) или ID (число с -100...).
# Пустые значения — слушаем только основные каналы.
#
# Пример хороших free-каналов:
#   Tree_Alpha_News    — mirror Tree of Alpha (быстрый агрегатор)
#   BWEnews            — агрегатор Binance + Upbit + Bithumb
#   binance_announcements — мирор Binance announcements
EXTRA_DELIST_CHANNELS=
EXTRA_LISTING_CHANNELS=

# ── Tree of Alpha free WebSocket (FIX-batch-4) ───────────────────
# Включает слушатель wss://news.treeofalpha.com/ws. Бесплатно,
# может опережать TG-мирроры на 50-500мс. Поставь 1/true для активации.
TREE_OF_ALPHA_WS_ENABLED=1

# ── Bybit V5 WebSocket Trading (FIX-batch-5) ─────────────────────
# Включает размещение ордеров через persistent WS вместо REST.
# Win: -30...-80мс на ордер. Fallback на REST при ошибке.
# Поставь 1/true для активации (требует BYBIT_API_KEY + SECRET).
BYBIT_WS_TRADE_ENABLED=1

# ── Прочие ───────────────────────────────────────────────────────
SOLANA_PRIVATE_KEY=
HYPERLIQUID_KEY=

# Папка с Telethon session-файлами (в Docker — /Parsers).
SESSION_DIR=/Parsers
