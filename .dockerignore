# FIX: исключаем секретные и ненужные файлы из образа
# Они монтируются через volumes в docker-compose.yml

# Секреты (монтируются через volumes)
.env
*.session

# Виртуальное окружение
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Логи и временные файлы
*.log
*.tmp

# IDE
.idea/
.vscode/
*.iml

# Git
.git/
.gitignore