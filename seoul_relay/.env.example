# Сгенерировать: openssl rand -hex 32
RELAY_SECRET=замени-меня-результатом-openssl-rand-hex-32-чем-длиннее-тем-лучше

# Korean residential proxies для обхода Cloudflare на Upbit-API.
# CF блочит datacenter IP диапазоны Vultr/Hetzner — residential KR IP
# проходит без 403. Формат — CSV (через запятую):
#   socks5://user:pass@kr1.proxy:1080,socks5://user:pass@kr2.proxy:1080
# или http://user:pass@host:port. Round-robin между ними.
UPBIT_PROXIES=

# Опционально (по умолчанию)
# BITHUMB_POLL_MS=50
# UPBIT_POLL_MS=80
# UPBIT_IMPERSONATE=chrome124
# UPBIT_ENABLED=1
